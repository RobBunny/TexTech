# Copy/configure locally. Never commit credentials. These are sanitized examples.
MONGODB_URI=
DATABASE_NAME=textech
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=TexTech
# starttls, ssl (typically port 465), or none (explicit local testing only)
SMTP_TLS_MODE=starttls
FRONTEND_BASE_URL=http://localhost:5173
# Verification lifetime remains 30 minutes. SMTP timeout is 10 seconds.
# SMTP acceptance is submission, not guaranteed inbox delivery.
# Failed delivery keeps the account; resend will be implemented in a later stage.
